# --- Local development (default) ---
# When DATABASE_URL is unset, CreativeOS uses an in-process PGlite Postgres.
# Point it at a folder so data persists across migrate/seed/dev runs.
PGLITE_DATA_DIR=./.pglite

# --- Production / Supabase (project rklzxvhrvmfhswaecyuk) ---
# Set DATABASE_URL to the Supabase Postgres connection string to use Supabase
# instead of PGlite. Migrations and schema are identical; run `pnpm db:migrate`.
# Prefer the connection pooler (IPv4, works from most hosts); add your DB password:
#   DATABASE_URL=postgresql://postgres.rklzxvhrvmfhswaecyuk:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Direct connection (IPv6) alternative:
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.rklzxvhrvmfhswaecyuk.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://rklzxvhrvmfhswaecyuk.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Phase 2: command-bar natural-language parsing ---
# ANTHROPIC_API_KEY=sk-ant-...
